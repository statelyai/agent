# Origin of the hosted Stately editor; the demo loads its keyless /inspect page.
VITE_VIZ_URL=https://editor.stately.ai
# Optional: replace the whole /inspect URL (e.g. a local viz app for ws:// relays).
# VITE_VIZ_INSPECT_URL=

# Optional, server-only. Without it, the UI clearly runs a pre-baked script.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Used only after real primary and retry failures. Defaults to OPENAI_MODEL.
OPENAI_FALLBACK_MODEL=
