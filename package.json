{
  "name": "@statelyai/agent",
  "version": "2.0.0-alpha.21",
  "description": "Make invalid agent actions impossible. Agent logic as state machines: deterministic, inspectable, resumable, runs anywhere.",
  "keywords": [
    "agent",
    "ai",
    "state machine",
    "statechart"
  ],
  "homepage": "https://github.com/statelyai/agent#readme",
  "bugs": {
    "url": "https://github.com/statelyai/agent/issues"
  },
  "license": "MIT",
  "author": "David Khourshid <david@stately.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/agent.git"
  },
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.mts",
        "default": "./dist/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./machines": {
      "import": {
        "types": "./dist/machines.d.mts",
        "default": "./dist/machines.mjs"
      },
      "require": {
        "types": "./dist/machines.d.cts",
        "default": "./dist/machines.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.mts",
        "default": "./dist/otel.mjs"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.mts",
        "default": "./dist/validate.mjs"
      },
      "require": {
        "types": "./dist/validate.d.cts",
        "default": "./dist/validate.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.mts",
        "default": "./dist/sqlite.mjs"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./agent-workflow.json": "./schemas/agent-workflow.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "demo": "pnpm --filter @statelyai/agent-demo dev",
    "proto:prefabs": "tsx .scratch/prefabs/demo.ts",
    "docs:check": "tsx scripts/check-docs-snippets.ts",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:examples && pnpm run typecheck:example-packages",
    "typecheck:src": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "typecheck:example-packages": "pnpm run build && tsc -p examples/next-host --noEmit && tsc -p examples/tanstack-start-host --noEmit && tsc -p examples/tanstack-ai-stream --noEmit && tsc -p examples/cloudflare-agent-host --noEmit && tsc -p examples/cloudflare-workers-ai-host --noEmit",
    "test:cloudflare": "pnpm --filter @statelyai/example-cloudflare-agent-host test && pnpm --filter @statelyai/example-cloudflare-workers-ai-host test",
    "lint": "oxlint",
    "format": "oxfmt src examples",
    "format:check": "oxfmt --check src examples",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip",
    "check:dts": "tsc -p fixtures/dts-consumer/tsconfig.json",
    "test": "vitest",
    "test:live": "LIVE_TESTS=1 vitest --run",
    "test:ci": "vitest --run && pnpm run test:cloudflare",
    "prepublishOnly": "tsdown",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@anthropic-ai/sdk": "^0.120.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@inquirer/prompts": "^8.6.0",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.10",
    "@mastra/core": "^1.61.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@statelyai/sdk": "^0.22.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "ai": "^7.0.0",
    "ajv": "^8.20.0",
    "braintrust": "^3.28.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "hono": "^4.13.3",
    "knip": "6.24.0",
    "langchain": "^1.5.10",
    "openai": "^7.5.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "react": "^19.2.8",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.12",
    "twoslash": "^0.3.9",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2",
    "vitest": "^4.1.11",
    "xstate": "6.0.0-alpha.48",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1",
    "ai": "^7.0.0",
    "ajv": "^8.20.0",
    "xstate": ">=6.0.0-alpha.46 <6.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ajv": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2"
}
