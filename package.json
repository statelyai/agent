{
  "name": "@statelyai/agent",
  "version": "2.0.0-alpha.28",
  "description": "Make invalid agent actions impossible. Agent logic as state machines: deterministic, inspectable, resumable, runs anywhere.",
  "keywords": [
    "agent",
    "ai",
    "state machine",
    "statechart"
  ],
  "homepage": "https://github.com/statelyai/agent#readme",
  "bugs": {
    "url": "https://github.com/statelyai/agent/issues"
  },
  "license": "MIT",
  "author": "David Khourshid <david@stately.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/agent.git"
  },
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.mts",
        "default": "./dist/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./log": {
      "import": {
        "types": "./dist/log.d.mts",
        "default": "./dist/log.mjs"
      },
      "require": {
        "types": "./dist/log.d.cts",
        "default": "./dist/log.cjs"
      }
    },
    "./machines": {
      "import": {
        "types": "./dist/machines.d.mts",
        "default": "./dist/machines.mjs"
      },
      "require": {
        "types": "./dist/machines.d.cts",
        "default": "./dist/machines.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/openai.d.mts",
        "default": "./dist/openai.mjs"
      },
      "require": {
        "types": "./dist/openai.d.cts",
        "default": "./dist/openai.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.mts",
        "default": "./dist/otel.mjs"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./tanstack-ai": {
      "import": {
        "types": "./dist/tanstack-ai.d.mts",
        "default": "./dist/tanstack-ai.mjs"
      },
      "require": {
        "types": "./dist/tanstack-ai.d.cts",
        "default": "./dist/tanstack-ai.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.mts",
        "default": "./dist/validate.mjs"
      },
      "require": {
        "types": "./dist/validate.d.cts",
        "default": "./dist/validate.cjs"
      }
    },
    "./agent-workflow.json": "./schemas/agent-workflow.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "demo": "pnpm --filter @statelyai/agent-demo dev",
    "proto:prefabs": "tsx .scratch/prefabs/demo.ts",
    "docs:check": "tsx scripts/check-docs-snippets.ts",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:examples && pnpm run typecheck:example-packages",
    "typecheck:src": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "typecheck:example-packages": "pnpm run build && tsc -p examples/next-host --noEmit && tsc -p examples/tanstack-ai-stream --noEmit && tsc -p examples/cloudflare-agent-host --noEmit && tsc -p examples/cloudflare-workers-ai-host --noEmit && tsc -p demo --noEmit",
    "test:cloudflare": "pnpm --filter @statelyai/example-cloudflare-agent-host test && pnpm --filter @statelyai/example-cloudflare-workers-ai-host test",
    "lint": "oxlint",
    "format": "oxfmt src examples",
    "format:check": "oxfmt --check src examples",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip",
    "check:dts": "tsc -p fixtures/dts-consumer/tsconfig.json",
    "test": "vitest",
    "test:live": "LIVE_TESTS=1 vitest --run",
    "test:ci": "vitest --run && pnpm run build && pnpm run test:cloudflare && pnpm --filter @statelyai/agent-demo test",
    "prepublishOnly": "tsdown",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.89",
    "@ai-sdk/typesafe-ai": "3.0.16",
    "@anthropic-ai/sdk": "^0.132.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@mastra/core": "^1.75.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@tanstack/ai": "^0.66.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "ai": "^7.0.133",
    "ajv": "^8.20.0",
    "braintrust": "^3.37.1",
    "dotenv": "^18.0.6",
    "knip": "6.40.0",
    "langchain": "^1.5.16",
    "openai": "^7.30.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "twoslash": "^0.3.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "xstate": "6.0.0-alpha.64",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1",
    "@tanstack/ai": ">=0.66.0 <1",
    "ai": "^7.0.0",
    "ajv": "^8.20.0",
    "openai": ">=5.0.0 <8",
    "xstate": "6.0.0-alpha.64"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2"
}
