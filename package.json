{
  "name": "@statelyai/agent",
  "version": "2.0.0",
  "description": "Lightweight, stateless, framework-agnostic state-machine-driven AI agents",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.mts",
        "default": "./dist/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/graph.d.mts",
        "default": "./dist/graph.mjs"
      },
      "require": {
        "types": "./dist/graph.d.cts",
        "default": "./dist/graph.cjs"
      }
    },
    "./xstate": {
      "import": {
        "types": "./dist/xstate.d.mts",
        "default": "./dist/xstate.mjs"
      },
      "require": {
        "types": "./dist/xstate.d.cts",
        "default": "./dist/xstate.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "prepublishOnly": "tsdown",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "keywords": [
    "ai",
    "state machine",
    "agent",
    "statechart",
    "classify",
    "decide"
  ],
  "author": "David Khourshid <david@stately.ai>",
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.10",
    "dotenv": "^16.4.5",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "vitest": "^2.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@statelyai/graph": "^0.11.0",
    "ai": "^6.0.67",
    "typescript": "^5.6.2",
    "xstate": "^5.26.0"
  },
  "packageManager": "pnpm@10.28.2"
}
