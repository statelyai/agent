{
  "name": "@statelyai/agent",
  "version": "2.0.0-alpha.0",
  "description": "State-machine authoring layer for AI agents",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.mts",
        "default": "./dist/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./agent-workflow.json": "./schemas/agent-workflow.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "pnpm run lint:src && pnpm run lint:examples",
    "lint:src": "tsc --noEmit",
    "lint:examples": "tsc -p examples/tsconfig.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "prepublishOnly": "tsdown",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "keywords": [
    "ai",
    "state machine",
    "agent",
    "statechart"
  ],
  "author": "David Khourshid <david@stately.ai>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.10",
    "ai": "^6.0.67",
    "agents": "0.11.5",
    "dotenv": "^16.4.5",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2",
    "xstate": "6.0.0-alpha.16",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ai": "^6.0.67",
    "xstate": "6.0.0-alpha.16"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.28.2"
}
