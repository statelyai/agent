{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": true,
    "paths": {
      "@statelyai/agent": ["./src/index.ts"],
      "@statelyai/agent/ai-sdk": ["./src/ai-sdk/index.ts"],
      "@statelyai/agent/openai-compat": ["./src/openai-compat/index.ts"],
      "@statelyai/agent/steps": ["./src/steps/index.ts"],
      "@statelyai/agent/adapter": ["./src/adapter/index.ts"],
      "@statelyai/agent/zod": ["./src/zod/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "examples"]
}
