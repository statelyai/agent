{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "email-drafter-agent",
  "main": "index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Agent class, bound as a Durable Object. `routeAgentRequest` derives the
  // URL segment from the binding name: `EmailDrafter` -> /agents/email-drafter/:name.
  "durable_objects": {
    "bindings": [{ "name": "EmailDrafter", "class_name": "EmailDrafter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EmailDrafter"] }],
  // This Worker imports `../email-drafter`, which lives in the library repo and
  // so reaches `@statelyai/agent` by self-reference, while this package reaches
  // it through its workspace link. Two specifiers can mean two copies in the
  // bundle, and the library keys machine metadata in module-level WeakMaps that
  // a second copy would silently miss. Pin both specifiers to one module.
  "alias": {
    "@statelyai/agent": "./node_modules/@statelyai/agent/dist/index.mjs",
    "@statelyai/agent/ai-sdk": "./node_modules/@statelyai/agent/dist/ai-sdk.mjs",
  },
  "observability": { "enabled": true },
}
