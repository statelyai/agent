{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "jsx": "react-jsx"
  },
  "include": ["."],
  // These are real workspace packages with real framework deps; each has its
  // own tsconfig and typechecks against the built package, not `src/`. The
  // Cloudflare ones also need Workers types (`cloudflare:test`, workerd
  // globals), which only their own tsconfigs pull in.
  // See the root `typecheck:example-packages` script.
  "exclude": [
    "next-host",
    "tanstack-ai-stream",
    "cloudflare-agent-host",
    "cloudflare-workers-ai-host"
  ]
}
