{
  "id": "support-ticket-json",
  "description": "Support ticket flow: decide escalate-vs-reply, draft a reply, wait for human approval. Defined entirely as data — no code, no eval.",
  "schemas": {
    "input": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        }
      },
      "required": ["ticket"]
    },
    "context": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "reply": {
          "type": "string"
        },
        "escalationReason": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["ticket"]
    },
    "events": {
      "ESCALATE": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": ["reason"]
      },
      "REPLY": {
        "type": "object",
        "properties": {}
      },
      "APPROVE": {
        "type": "object",
        "properties": {}
      },
      "REJECT": {
        "type": "object",
        "properties": {}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "string",
          "enum": ["replied", "escalated", "failed"]
        },
        "reply": {
          "type": "string"
        },
        "escalationReason": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["resolution"]
    }
  },
  "context": {
    "ticket": "{{ input.ticket }}"
  },
  "requests": {
    "draftReply": {
      "model": "openai/gpt-5.4-mini",
      "system": "Draft a short, courteous support reply to the customer's ticket.",
      "prompt": "{{ input.ticket }}",
      "input": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string"
          }
        },
        "required": ["ticket"]
      },
      "output": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string"
          }
        },
        "required": ["reply"]
      }
    }
  },
  "initial": "triaging",
  "states": {
    "triaging": {
      "invoke": {
        "id": "triageDecision",
        "src": "agent.decide",
        "input": {
          "model": "openai/gpt-5.4-mini",
          "system": "Decide whether this support ticket needs human escalation or a drafted reply.",
          "prompt": "{{ context.ticket }}",
          "allowedEvents": ["ESCALATE", "REPLY"],
          "maxRetries": 2
        },
        "onError": {
          "target": "failed",
          "assign": {
            "error": "Triage decision failed: {{ event.error.message }}"
          }
        }
      },
      "on": {
        "ESCALATE": {
          "target": "escalated",
          "assign": {
            "escalationReason": "{{ event.reason }}"
          }
        },
        "REPLY": {
          "target": "drafting"
        }
      }
    },
    "drafting": {
      "invoke": {
        "id": "draft",
        "src": "draftReply",
        "input": {
          "ticket": "{{ context.ticket }}"
        },
        "onDone": {
          "target": "awaitingApproval",
          "assign": {
            "reply": "{{ event.output.reply }}"
          }
        },
        "onError": {
          "target": "failed",
          "assign": {
            "error": "Drafting the reply failed: {{ event.error.message }}"
          }
        }
      }
    },
    "awaitingApproval": {
      "description": "Idle: nothing left to do until a human approves or rejects the drafted reply.",
      "tags": ["awaiting-approval"],
      "meta": {
        "interaction": {
          "label": "Nothing left to do until you approve or reject the drafted reply.",
          "events": {
            "APPROVE": {
              "label": "Send reply",
              "style": "primary"
            },
            "REJECT": {
              "label": "Reject and escalate",
              "style": "danger"
            }
          }
        }
      },
      "on": {
        "APPROVE": {
          "target": "replied"
        },
        "REJECT": {
          "target": "escalated",
          "assign": {
            "escalationReason": "Reviewer rejected the drafted reply."
          }
        }
      }
    },
    "replied": {
      "type": "final",
      "output": {
        "resolution": "replied",
        "reply": "{{ context.reply }}"
      }
    },
    "escalated": {
      "type": "final",
      "output": {
        "resolution": "escalated",
        "escalationReason": "{{ context.escalationReason }}",
        "reply": "{{ context.reply }}"
      }
    },
    "failed": {
      "type": "final",
      "output": {
        "resolution": "failed",
        "error": "{{ context.error }}"
      }
    }
  }
}
