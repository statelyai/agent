{
  "name": "code-assistant",
  "title": "Self-correcting code assistant",
  "kind": "agent-workflow",
  "origin": {
    "type": "langgraph",
    "source": "LangGraph code assistant tutorial",
    "url": "https://langchain-ai.github.io/langgraph/tutorials/code_assistant/langgraph_code_assistant/"
  },
  "comparison": {
    "targets": [
      "LangGraph"
    ],
    "purpose": "Self-correcting code generation as explicit machine states: generate → sandboxed execute/check → (pass | reflect on failures → regenerate), bounded by a retry budget."
  },
  "starters": [
    {
      "spec": "Return the nth Fibonacci number (0-indexed).",
      "functionName": "fib",
      "checks": [
        {
          "args": [
            0
          ],
          "expected": 0
        },
        {
          "args": [
            7
          ],
          "expected": 13
        }
      ]
    },
    {
      "spec": "Return true if the string is a palindrome, ignoring case.",
      "functionName": "isPalindrome",
      "checks": [
        {
          "args": [
            "Racecar"
          ],
          "expected": true
        },
        {
          "args": [
            "hello"
          ],
          "expected": false
        }
      ]
    }
  ]
}
