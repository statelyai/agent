{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workers-ai-game-host",
  "main": "index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI inference. `wrangler dev` runs the Worker locally but proxies
  // this binding to the logged-in Cloudflare account, so a local run does real
  // inference (and is billed like one).
  "ai": { "binding": "AI" },
  // This Worker imports `../game-agent`, which lives in the library repo and so
  // reaches `@statelyai/agent` by self-reference, while this package reaches it
  // through its workspace link. Two specifiers, two copies in the bundle — and
  // the library keys machine schemas in a module-level WeakMap, so a second
  // copy silently loses them (replay then diverges on the effects hash). Pin
  // both specifiers to one module.
  "alias": {
    "@statelyai/agent": "./node_modules/@statelyai/agent/dist/index.mjs",
    "@statelyai/agent/ai-sdk": "./node_modules/@statelyai/agent/dist/ai-sdk.mjs",
  },
  "observability": { "enabled": true },
}
